Search Patient By Name 
create procedure to search 
 delimiter $$
mysql> create procedure sreachPatient(In name varchar(20))
    -> begin
    -> select * from patient where patient_name = name;
    -> end $$
Query OK, 0 rows affected (0.04 sec)

mysql> delimiter ;

Output : 
