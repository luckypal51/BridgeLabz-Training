Update patient details :
create procedure to update patient detail 
 delimiter $$
mysql> create procedure updateInfo(In id integer,In dob Date ,In name varchar(20),In contact varchar(15),In addres varchar(100),In blood char)
    -> Begin
    -> update patient set DOB = dob,patient_name = name,contact = contact, address = addres,bloodGroup = blood where patient_id = id;
    -> END $$
Query OK, 0 rows affected (0.06 sec)

mysql> delimiter ;

Output :
mysql> call updateInfo(1,"2003-11-05","Himesh Kurmi","8305144536","Anand Nagar",'B');
Query OK, 1 row affected (0.07 sec)

mysql> select * from patient;
