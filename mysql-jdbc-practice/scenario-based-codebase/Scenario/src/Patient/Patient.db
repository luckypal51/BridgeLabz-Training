creating patient table :
mysql> create table patient(patient_id integer auto_increment primary Key, DOB Date , patient_name varchar(50), contact varchar(50),address varchar(150), bloodGroup char);
Query OK, 0 rows affected (0.14 sec)

Created Procedure to add patient :
mysql> DELIMITER $$
mysql> CREATE PROCEDURE addpeople(
    ->     IN dob DATE,
    ->     IN pname VARCHAR(100),
    ->     IN con VARCHAR(50),
    ->     IN addre VARCHAR(150),
    ->     IN blood CHAR(3)
    -> )
    -> BEGIN
    ->     INSERT INTO Patient (DOB, patient_name, contact, address, bloodGroup)
    ->     VALUES (dob, pname, con, addre, blood);
    -> END $$
Query OK, 0 rows affected (0.02 sec)

mysql>
