creating procedure to assign or update the specialization 
 delimiter $$
mysql> create procedure assignSpeciality(In doctorName varchar(20),In special integer)
    -> begin
    -> update doctor set specialization = special where doctorName = name;
    -> end $$
Query OK, 0 rows affected (0.04 sec)

mysql> delimiter ;

Output :
mysql> call assignSpeciality("Nageshwar Patel",102);
Query OK, 1 row affected (0.02 sec)

mysql> select * from doctor;
