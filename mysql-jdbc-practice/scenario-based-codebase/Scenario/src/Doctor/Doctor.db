create table for specialization

Create table specialist(id integer primary key,type varchar(50));
mysql> describe specialist;
+-------+-------------+------+-----+---------+-------+
| Field | Type        | Null | Key | Default | Extra |
+-------+-------------+------+-----+---------+-------+
| id    | int         | NO   | PRI | NULL    |       |
| type  | varchar(50) | YES  |     | NULL    |       |
+-------+-------------+------+-----+---------+-------+
2 rows in set (0.02 sec)

mysql> insert into specialist(id,type)
       -> values(101,"Cardiology"),
       ->(102,"Pediatrics"),
       ->(103,"Dermatology"),
       ->(104,"Orthopedics");
Query OK, 4 rows affected (0.08 sec)
Records: 4  Duplicates: 0  Warnings: 0

mysql> select * from specialist;
