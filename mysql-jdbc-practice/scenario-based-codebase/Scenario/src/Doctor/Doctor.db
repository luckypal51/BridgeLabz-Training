Deactive doctor form doctor table 
creating procedure :
mysql> delimiter $$
mysql> create procedure deactived(In docName varchar(20))
    -> begin
    -> update doctor set is_active = false where name = docName;
    -> end $$
Query OK, 0 rows affected (0.01 sec)

mysql> delimiter ;

Output :
mysql> call deactived("Himesh Kurmi");
Query OK, 1 row affected (0.02 sec)

mysql> select * from doctor ;
