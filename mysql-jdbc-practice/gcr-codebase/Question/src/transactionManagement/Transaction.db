create two table one accounts and transcation

Accounts table :
mysql> create table accounts(acc_no integer auto_increment primary key, acc_holder_name varchar(50),balance decimal(10,2) default 0);
Query OK, 0 rows affected (0.19 sec)
Output : 
mysql> describe accounts;
+-----------------+---------------+------+-----+---------+----------------+
| Field           | Type          | Null | Key | Default | Extra          |
+-----------------+---------------+------+-----+---------+----------------+
| acc_no          | int           | NO   | PRI | NULL    | auto_increment |
| acc_holder_name | varchar(50)   | YES  |     | NULL    |                |
| balance         | decimal(10,2) | YES  |     | 0.00    |                |
+-----------------+---------------+------+-----+---------+----------------+
3 rows in set (0.09 sec)

Transaction table :
mysql> create table transactions(trans_id integer auto_increment primary key, trans_type varchar(50),trans_amount decimal(10,2), acc_no integer, constraint fk_acc foreign key (acc_no) references accounts(acc_no));
Query OK, 0 rows affected (0.10 sec)
Output :

mysql> describe transactions;
+--------------+---------------+------+-----+---------+----------------+
| Field        | Type          | Null | Key | Default | Extra          |
+--------------+---------------+------+-----+---------+----------------+
| trans_id     | int           | NO   | PRI | NULL    | auto_increment |
| trans_type   | varchar(50)   | YES  |     | NULL    |                |
| trans_amount | decimal(10,2) | YES  |     | NULL    |                |
| acc_no       | int           | YES  | MUL | NULL    |                |
+--------------+---------------+------+-----+---------+----------------+
4 rows in set (0.01 sec)

--------------------------------------------------------------------------------------------------------------------------------------------------
Money Transaction withradwal 
creating procedure to make transactions
mysql> DELIMITER $$
mysql>
mysql> CREATE PROCEDURE withdrawal(
    ->     IN rec_id INT,
    ->     IN sen_id INT,
    ->     IN amount DECIMAL(10,2)
    -> )
    -> BEGIN
    ->     DECLARE sender_bal DECIMAL(10,2);
    ->
    ->     START TRANSACTION;
    ->
    ->     SELECT balance
    ->     INTO sender_bal
    ->     FROM accounts
    ->     WHERE acc_no = sen_id
    ->     FOR UPDATE;
    ->
    ->     IF sender_bal >= amount THEN
    ->
    ->         UPDATE accounts
    ->         SET balance = balance - amount
    ->         WHERE acc_no = sen_id;
    ->
    ->         UPDATE accounts
    ->         SET balance = balance + amount
    ->         WHERE acc_no = rec_id;
    ->
    ->         INSERT INTO transactions (trans_type, trans_amount, acc_no)
    ->         VALUES ('WITHDRAWAL', amount, sen_id),
    ->                ('CREDIT', amount, rec_id);
    ->
    ->         COMMIT;
    ->     ELSE
    ->         ROLLBACK;
    ->     END IF;
    ->
    -> END $$
Query OK, 0 rows affected (0.01 sec)

mysql>
mysql> DELIMITER ;

Before transactions :
ysql> SELECT * FROM accounts;
+--------+-----------------+----------+
| acc_no | acc_holder_name | balance  |
+--------+-----------------+----------+
|      1 | lucky pal       | 12000.00 |
|      2 | Himesh          |     0.00 |
+--------+-----------------+----------+
2 rows in set (0.01 sec)

After Transaction :

mysql> call withdrawal(2,1,3000);
Query OK, 0 rows affected (0.02 sec)

mysql> SELECT * FROM accounts;
+--------+-----------------+----------+
| acc_no | acc_holder_name | balance  |
+--------+-----------------+----------+
|      1 | lucky pal       | 12000.00 |
|      2 | Himesh          |  3000.00 |
+--------+-----------------+----------+
2 rows in set (0.01 sec)

Tansaction table details :
select * from transactions;
