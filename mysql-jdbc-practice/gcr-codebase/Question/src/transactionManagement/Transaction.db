View Transaction History 
created procedure :

mysql> DELIMITER $$
mysql> CREATE PROCEDURE viewTransaction(IN account_no integer)
    -> BEGIN
    -> SELECT * FROM transactions where acc_no= account_no;
    -> END $$
Query OK, 0 rows affected (0.01 sec)

mysql> DELIMITER ;

Output :
mysql> CALL viewTransaction(2);
+----------+------------+--------------+--------+
| trans_id | trans_type | trans_amount | acc_no |
+----------+------------+--------------+--------+
|        2 | CREDIT     |      3000.00 |      2 |
|        3 | WITHDRAWAL |        35.00 |      2 |
|        5 | WITHDRAWAL |       300.00 |      2 |
+----------+------------+--------------+--------+
3 rows in set (0.01 sec)

