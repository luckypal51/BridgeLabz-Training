Search employee by name
create procedure to search employee 
mysql> DELIMITER $$
mysql>  CREATE PROCEDURE searchByName2(IN name varchar(50))
    ->  BEGIN
    -> SELECT * FROM employees WHERE emp_name = name;
    -> END $$
Query OK, 0 rows affected (0.01 sec)
mysql> DELIMITER ;

OUTPUT ->
mysql> CALL searchByName2("Nageshwar Patel");
+--------+-----------------+------------+------+
| emp_id | emp_name        | emp_salary | dept |
+--------+-----------------+------------+------+
|    103 | Nageshwar Patel | 85000      | IT   |
